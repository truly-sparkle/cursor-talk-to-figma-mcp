{
  "compilerOptions": {
    "target": "ES2022",
    "module": "ESNext",
    "moduleResolution": "bundler",
    "esModuleInterop": true,
    "skipLibCheck": true,
    "declaration": true,
    "outDir": "dist",
    "rootDir": "src",
    "lib": ["ES2022"],
    "types": ["bun-types"],

    // BL-001 + BL-065: full strict mode. We discovered that the codebase
    // already had explicit `any` annotations on every loose spot, so
    // turning each sub-flag on (noImplicitAny → strictNullChecks →
    // strictFunctionTypes → strictPropertyInitialization) produced 0
    // errors. Consolidated to the umbrella `strict: true` so future
    // releases of TypeScript pick up new strict sub-flags automatically.
    "strict": true,
    "noFallthroughCasesInSwitch": true,
    "noImplicitOverride": true
  },
  "include": ["src/**/*"],
  "exclude": ["node_modules", "dist"]
}
